{
  "name": "t5-market-import",
  "version": "1.0.0",
  "description": "Excel -> SQLite converter for outdoor rug market data",
  "main": "src/import_xlsx.js",
  "scripts": {
    "import:base": "node src/import_xlsx.js",
    "build:competitor": "node src/build_competitor_db.js",
    "apply:competitor": "node src/apply_competitor_2026.js",
    "import": "npm run import:base && npm run build:competitor && npm run apply:competitor",
    "verify": "node tests/verify.js",
    "audit": "node tests/full_audit.js",
    "audit:competitor": "node tests/competitor_audit.js",
    "audit:plan-reference": "node tests/plan_reference_audit.js",
    "test:overwrite": "node tests/overwrite_guard.js",
    "test:analysis": "node tests/spec21_model_audit.mjs && node tests/spec2_audit.mjs",
    "build:delivery": "node src/build_delivery.mjs",
    "test": "node tests/spec21_checks.mjs",
    "test:inputs": "node tests/spec21_checks.mjs --inputs",
    "analyze": "node src/build_delivery.mjs",
    "analyze:legacy": "node src/analyze_market.js",
    "analyze:spec2": "node src/build_spec2_html.mjs",
    "poc": "node sandbox/test_xlsx.js",
    "test:frontend": "node tests/spec21_checks.mjs --delivery",
    "build:parent": "node src/build_parent_source_delivery.mjs",
    "test:parent": "node tests/parent_source_audit.mjs",
    "test:parent:formula": "node src/run_parent_formula_audit.mjs"
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "ISC"
}
